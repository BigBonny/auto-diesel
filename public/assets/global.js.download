$(document).ready(function() {
    $('#btnShowDetailCar').on('click', function(e) {
        e.preventDefault();

        var $detail = $('.detail-car');

        if ($detail.is(':visible')) {
            $detail.slideUp(300, function() {
                $detail.addClass('d-none');
            });
        } else {
            $detail.removeClass('d-none').hide().slideDown(300);
        }
    });
});

$(document).on('click', '.clickall', function(e) {
    // évite de déclencher si on clique un bouton ou un lien interne
    if ($(e.target).closest('a, button').length === 0) {
        window.location = $(this).data('href');
    }
});

document.addEventListener('DOMContentLoaded', function () {
    var toggle = document.querySelector('.breadcrumb-mobile[data-bc-toggle]');
    var breadcrumb = document.querySelector('.breadcrumb');

    if (toggle && breadcrumb) {
        toggle.addEventListener('click', function () {
            breadcrumb.classList.add('is-expanded');
        });
    }
});
